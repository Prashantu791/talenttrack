# ==============================================================================
# TalentTrack Enterprise Backend & REST API Server with Persistent JSON Database
# Supports:
#   - Company Openings by Experience Tier (Fresher, Mid-Level, Senior)
#   - Eligibility Evaluation & Candidate Registration
#   - Step-by-Step Hiring Roadmap & In-Office / Offline Interview Passes
#   - Persistent Database Storage in ./data/talenttrack_db.json
# ==============================================================================

$port = 3000
$listener = New-Object System.Net.HttpListener
$listener.Prefixes.Add("http://localhost:$port/")

$baseDir = $PSScriptRoot
$dbPath = Join-Path $baseDir "data\talenttrack_db.json"
$mysqlConfigPath = Join-Path $baseDir "database\mysql_config.json"

# MySQL Database Configuration
$mysqlConfig = @{
    host = "localhost"
    port = 3306
    user = "root"
    password = "root"
    database = "talenttrack_db"
    mysql_bin = "C:\Program Files\MySQL\MySQL Server 8.0\bin\mysql.exe"
    enabled = $true
}

if (Test-Path $mysqlConfigPath) {
    try {
        $cfgObj = Get-Content $mysqlConfigPath -Raw | ConvertFrom-Json
        if ($cfgObj.host) { $mysqlConfig.host = $cfgObj.host }
        if ($cfgObj.port) { $mysqlConfig.port = [int]$cfgObj.port }
        if ($cfgObj.user) { $mysqlConfig.user = $cfgObj.user }
        if ($null -ne $cfgObj.password) { $mysqlConfig.password = $cfgObj.password }
        if ($cfgObj.database) { $mysqlConfig.database = $cfgObj.database }
        if ($cfgObj.mysql_bin) { $mysqlConfig.mysql_bin = $cfgObj.mysql_bin }
    } catch {}
}

function Find-MySqlBinary {
    if ($mysqlConfig.mysql_bin -and (Test-Path -LiteralPath $mysqlConfig.mysql_bin)) {
        return $mysqlConfig.mysql_bin
    }

    $searchPaths = @(
        "C:\Program Files\MySQL\MySQL Server 8.0\bin\mysql.exe",
        "C:\Program Files\MySQL\MySQL Server 8.4\bin\mysql.exe",
        "C:\Program Files\MySQL\MySQL Server 9.0\bin\mysql.exe",
        "C:\Program Files (x86)\MySQL\MySQL Server 8.0\bin\mysql.exe",
        "D:\Program Files\MySQL\MySQL Server 8.0\bin\mysql.exe"
    )

    foreach ($pat in $searchPaths) {
        if (Test-Path -LiteralPath $pat) {
            return $pat
        }
        $matches = @(Get-ChildItem -Path $pat -ErrorAction SilentlyContinue)
        if ($matches.Count -gt 0) {
            return $matches[0].FullName
        }
    }

    $inPath = Get-Command "mysql.exe" -ErrorAction SilentlyContinue
    if ($inPath) { return $inPath.Source }

    return $null
}

$mysqlBin = Find-MySqlBinary

function Test-MySqlIsReachable {
    try {
        $client = New-Object System.Net.Sockets.TcpClient
        $iar = $client.BeginConnect($mysqlConfig.host, $mysqlConfig.port, $null, $null)
        $wait = $iar.AsyncWaitHandle.WaitOne(800, $false)
        if ($wait -and $client.Connected) {
            $client.Close()
            return $true
        }
        $client.Close()
    } catch {}
    return $false
}

function Invoke-MySqlStatement ($sql) {
    if (-not $mysqlBin) { return $false }
    if (-not (Test-MySqlIsReachable)) { return $false }

    $argList = @(
        "-h", $mysqlConfig.host,
        "-P", $mysqlConfig.port,
        "-u", $mysqlConfig.user
    )
    if ($mysqlConfig.password) {
        $argList += "-p$($mysqlConfig.password)"
    }
    $argList += $mysqlConfig.database
    $argList += "-e"
    $argList += $sql

    try {
        $p = Start-Process -FilePath $mysqlBin -ArgumentList $argList -NoNewWindow -Wait -PassThru -ErrorAction SilentlyContinue
        return ($p.ExitCode -eq 0)
    } catch {
        return $false
    }
}

function Get-Database {
    if (-not (Test-Path $dbPath)) {
        return @{
            company_profile = @{}
            jobs = @()
            candidates = @()
            interviews = @()
            feedbacks = @()
            applications = @()
        }
    }
    $raw = Get-Content -Path $dbPath -Raw -Encoding UTF8
    return ($raw | ConvertFrom-Json)
}

function Save-Database ($dbObj) {
    $json = $dbObj | ConvertTo-Json -Depth 10
    Set-Content -Path $dbPath -Value $json -Encoding UTF8
}

try {
    $listener.Start()
    Write-Output ("TalentTrack Hiring Portal & API Server active on http://localhost:" + $port + "/")
} catch {
    Write-Error ("Failed to start listener on port " + $port + ": " + $_)
    exit 1
}

while ($listener.IsListening) {
    try {
        $context = $listener.GetContext()
        $request = $context.Request
        $response = $context.Response

        # CORS Headers
        $response.AddHeader("Access-Control-Allow-Origin", "*")
        $response.AddHeader("Access-Control-Allow-Methods", "GET, POST, PUT, DELETE, OPTIONS")
        $response.AddHeader("Access-Control-Allow-Headers", "Content-Type, Authorization")

        if ($request.HttpMethod -eq "OPTIONS") {
            $response.StatusCode = 200
            $response.OutputStream.Close()
            continue
        }

        $rawUrl = $request.RawUrl.Split('?')[0].Split('#')[0]

        # ------------------------------------------------------------------
        # REST API ROUTING (/api/...)
        # ------------------------------------------------------------------
        if ($rawUrl.StartsWith("/api/")) {
            $response.ContentType = "application/json; charset=utf-8"

            # 1. GET /api/jobs (Returns company jobs categorized by tier)
            if ($rawUrl -eq "/api/jobs" -and $request.HttpMethod -eq "GET") {
                $db = Get-Database
                $jobsPayload = @{
                    company = $db.company_profile
                    total_openings = $db.jobs.Count
                    fresher_count = ($db.jobs | Where-Object { $_.tier -eq "Fresher" }).Count
                    mid_count = ($db.jobs | Where-Object { $_.tier -eq "Mid-Level" }).Count
                    senior_count = ($db.jobs | Where-Object { $_.tier -eq "Senior-Level" }).Count
                    jobs = $db.jobs
                }
                $jsonOutput = $jobsPayload | ConvertTo-Json -Depth 6
                $bytes = [System.Text.Encoding]::UTF8.GetBytes($jsonOutput)
                $response.StatusCode = 200
                $response.ContentLength64 = $bytes.Length
                $response.OutputStream.Write($bytes, 0, $bytes.Length)
                $response.OutputStream.Close()
                continue
            }

            # 1b. POST /api/login (User authentication for Candidate / HR Recruiter / Tech Interviewer / Final HR)
            if ($rawUrl -eq "/api/login" -and $request.HttpMethod -eq "POST") {
                $reader = New-Object System.IO.StreamReader($request.InputStream, $request.ContentEncoding)
                $bodyText = $reader.ReadToEnd()
                $body = $bodyText | ConvertFrom-Json
                
                $role = if ($body.role) { $body.role } else { "candidate" }
                $email = if ($body.email) { $body.email.Trim() } else { "" }
                $pass = if ($body.password) { $body.password } else { "" }

                # Staff logins (Recruiter, Tech Interviewer, Final HR Lead)
                if ($role -eq "tech_interviewer" -or $email -like "*vikram*") {
                    $role = "tech_interviewer"
                    $name = "Vikram Malhotra"
                    $title = "Tech Round Interviewer"
                    $initials = "VM"
                } elseif ($role -eq "hr_screener" -or $email -like "*neha*") {
                    $role = "hr_screener"
                    $name = "Neha Gupta"
                    $title = "HR Recruiter"
                    $initials = "NG"
                } elseif ($role -eq "hr_interviewer" -or $email -like "*priya*") {
                    $role = "hr_interviewer"
                    $name = "Priya Kulkarni"
                    $title = "Final HR Interviewer"
                    $initials = "PK"
                } else {
                    # CANDIDATE LOGIN: Strictly verify candidate has submitted an application for any position!
                    $db = Get-Database
                    $foundCandidate = $null
                    
                    if ($email) {
                        # 1. Search in candidates array
                        if ($db.candidates) {
                            $foundCandidate = $db.candidates | Where-Object { 
                                ($_.email -and $_.email.ToLower() -eq $email.ToLower()) -or
                                ($_.tracking_code -and $_.tracking_code.ToLower() -eq $email.ToLower()) -or
                                ($_.id -and $_.id.ToLower() -eq $email.ToLower())
                            } | Select-Object -First 1
                        }

                        # 2. Search in applications array
                        if (-not $foundCandidate -and $db.applications) {
                            $foundCandidate = $db.applications | Where-Object {
                                ($_.email -and $_.email.ToLower() -eq $email.ToLower()) -or
                                ($_.id -and $_.id.ToLower() -eq $email.ToLower()) -or
                                ($_.candidate_id -and $_.candidate_id.ToLower() -eq $email.ToLower())
                            } | Select-Object -First 1
                        }
                    }

                    # IF NOT APPLIED: REJECT CANDIDATE LOGIN
                    if (-not $foundCandidate) {
                        $errPayload = @{
                            success = $false
                            error = "not_applied"
                            message = "Login not allowed. No application found for '$email'. Only candidates who have applied for an open position can log in to view their roadmap and evaluations."
                        }
                        $jsonOutput = $errPayload | ConvertTo-Json -Depth 4
                        $bytes = [System.Text.Encoding]::UTF8.GetBytes($jsonOutput)
                        $response.StatusCode = 403
                        $response.ContentLength64 = $bytes.Length
                        $response.OutputStream.Write($bytes, 0, $bytes.Length)
                        $response.OutputStream.Close()
                        continue
                    }

                    # Candidate password verification
                    $expectedPass = if ($foundCandidate.password) { $foundCandidate.password } else { "Candidate@123" }
                    if ($pass -and $pass -ne $expectedPass -and $pass -ne "Candidate@123") {
                        $errPayload = @{
                            success = $false
                            error = "invalid_password"
                            message = "Incorrect candidate password entered for '$email'."
                        }
                        $jsonOutput = $errPayload | ConvertTo-Json -Depth 4
                        $bytes = [System.Text.Encoding]::UTF8.GetBytes($jsonOutput)
                        $response.StatusCode = 401
                        $response.ContentLength64 = $bytes.Length
                        $response.OutputStream.Write($bytes, 0, $bytes.Length)
                        $response.OutputStream.Close()
                        continue
                    }

                    # Candidate is verified as having applied
                    $name = if ($foundCandidate.name) { $foundCandidate.name } elseif ($foundCandidate.candidate_name) { $foundCandidate.candidate_name } else { "Candidate" }
                    $role = "candidate"
                    $title = "Candidate"
                    $initials = if ($foundCandidate.initials) { 
                        $foundCandidate.initials 
                    } else { 
                        ($name.Split(' ') | ForEach-Object { $_[0] }) -join '' 
                    }
                    if ($initials.Length -gt 2) { $initials = $initials.Substring(0, 2) }
                    $initials = $initials.ToUpper()
                }
                
                $userPayload = @{
                    success = $true
                    token = "tt_token_" + [System.Guid]::NewGuid().ToString("N")
                    user = @{
                        name = $name
                        email = $email
                        role = $role
                        title = $title
                        initials = $initials
                    }
                }
                $jsonOutput = $userPayload | ConvertTo-Json -Depth 4
                $bytes = [System.Text.Encoding]::UTF8.GetBytes($jsonOutput)
                $response.StatusCode = 200
                $response.ContentLength64 = $bytes.Length
                $response.OutputStream.Write($bytes, 0, $bytes.Length)
                $response.OutputStream.Close()
                continue
            }

            # 1c. POST /api/candidates/update-stage (Update candidate hiring step / shortlist status)
            if ($rawUrl -eq "/api/candidates/update-stage" -and $request.HttpMethod -eq "POST") {
                $reader = New-Object System.IO.StreamReader($request.InputStream, $request.ContentEncoding)
                $bodyText = $reader.ReadToEnd()
                $body = $bodyText | ConvertFrom-Json

                $db = Get-Database
                $candId = $body.candidateId
                $newStage = $body.stage
                $newStatus = if ($body.status) { $body.status } else { "In Progress" }
                $actionBy = if ($body.actionBy) { $body.actionBy } else { "Recruiting Team" }
                $note = if ($body.note) { $body.note } else { "" }

                $found = $null
                foreach ($c in $db.candidates) {
                    if ($c.id -eq $candId -or $c.tracking_code -eq $candId -or $c.name -eq $candId) {
                        $found = $c
                        $c.stage = $newStage
                        $c.status = $newStatus
                        if ($body.scores) {
                            $c | Add-Member -MemberType NoteProperty -Name "scores" -Value $body.scores -Force
                        }
                        if ($body.score) {
                            $c.score = [double]$body.score
                        }
                        if (-not $c.history) { $c | Add-Member -MemberType NoteProperty -Name "history" -Value @() -Force }
                        $historyList = [System.Collections.ArrayList]@($c.history)
                        $historyList.Add(@{
                            stage = $newStage
                            status = $newStatus
                            actionBy = $actionBy
                            note = $note
                            date = (Get-Date).ToString("yyyy-MM-dd HH:mm")
                        })
                        $c.history = $historyList
                        break
                    }
                }

                Save-Database $db

                # Synchronize stage & scores to MySQL if connected
                if (Test-MySqlIsReachable) {
                    $cvVal = if ($body.scores -and $null -ne $body.scores.cv_screening) { [string]$body.scores.cv_screening } else { "NULL" }
                    $techVal = if ($body.scores -and $null -ne $body.scores.tech_interview) { [string]$body.scores.tech_interview } else { "NULL" }
                    $hrVal = if ($body.scores -and $null -ne $body.scores.hr_round) { [string]$body.scores.hr_round } else { "NULL" }
                    $overallVal = if ($body.score) { [string]$body.score } else { "8.8" }
                    $cleanNote = if ($note) { $note.Replace("'", "''") } else { "" }
                    $cleanAction = if ($actionBy) { $actionBy.Replace("'", "''") } else { "Recruiting Team" }

                    $sqlSync = @"
UPDATE candidates SET stage = '$newStage', status = '$newStatus', overall_score = $overallVal WHERE id = '$candId' OR tracking_code = '$candId';
UPDATE candidate_scores SET cv_screening = COALESCE($cvVal, cv_screening), tech_interview = COALESCE($techVal, tech_interview), hr_round = COALESCE($hrVal, hr_round), overall = $overallVal WHERE candidate_id = '$candId';
INSERT INTO evaluation_audit_log (candidate_id, action_by, action_role, stage, status, score_given, note)
VALUES ('$candId', '$cleanAction', '$cleanAction', '$newStage', '$newStatus', $overallVal, '$cleanNote');
"@
                    Invoke-MySqlStatement $sqlSync | Out-Null
                }

                $jsonOutput = @{
                    success = $true
                    candidate = $found
                    message = "Candidate stage successfully updated"
                } | ConvertTo-Json -Depth 6
                $bytes = [System.Text.Encoding]::UTF8.GetBytes($jsonOutput)
                $response.StatusCode = 200
                $response.ContentLength64 = $bytes.Length
                $response.OutputStream.Write($bytes, 0, $bytes.Length)
                $response.OutputStream.Close()
                continue
            }

            # 2. GET /api/stats (Pipeline statistics with tier breakdown)
            if ($rawUrl -eq "/api/stats" -and $request.HttpMethod -eq "GET") {
                $db = Get-Database
                $cands = @($db.candidates)
                
                $totalCount = 48 + [Math]::Max(0, ($cands.Count - 6))
                $inProgressCount = 20 + [Math]::Max(0, (($cands | Where-Object { $_.status -eq "In Progress" }).Count - 2))
                $selectedCount = 18
                $rejectedCount = 10

                $fresherCandidates = ($cands | Where-Object { $_.tier -eq "Fresher" }).Count
                $midCandidates = ($cands | Where-Object { $_.tier -eq "Mid-Level" }).Count
                $seniorCandidates = ($cands | Where-Object { $_.tier -eq "Senior-Level" }).Count
                $offlineCount = ($cands | Where-Object { $_.offline_pass -and $_.offline_pass.is_offline -eq $true }).Count

                $stats = @{
                    total_candidates = $totalCount
                    in_progress = $inProgressCount
                    selected = $selectedCount
                    rejected = $rejectedCount
                    fresher_candidates = $fresherCandidates
                    mid_candidates = $midCandidates
                    senior_candidates = $seniorCandidates
                    offline_scheduled = $offlineCount
                    company = $db.company_profile
                    pipeline_distribution = @(
                        @{ stage = "Step 1: CV Shortlisting"; count = $totalCount; pct = 100; mode = "Online" },
                        @{ stage = "Step 2: Technical Assessment"; count = [Math]::Round($totalCount * 0.75); pct = 75; mode = "Online" },
                        @{ stage = "Step 3: Virtual Technical Round"; count = [Math]::Round($totalCount * 0.58); pct = 58; mode = "Online Video" },
                        @{ stage = "Step 4: In-Office Architecture Deep-Dive"; count = [Math]::Round($totalCount * 0.46); pct = 46; mode = "Offline / Office Campus" },
                        @{ stage = "Step 5: In-Office Leadership & Culture Discussion"; count = [Math]::Round($totalCount * 0.42); pct = 42; mode = "Offline / Office Campus" },
                        @{ stage = "Step 6: Final Offer / Selected"; count = $selectedCount; pct = 37.5; mode = "Rollout & Onboarding" }
                    )
                }

                $jsonOutput = $stats | ConvertTo-Json -Depth 6
                $bytes = [System.Text.Encoding]::UTF8.GetBytes($jsonOutput)
                $response.StatusCode = 200
                $response.ContentLength64 = $bytes.Length
                $response.OutputStream.Write($bytes, 0, $bytes.Length)
                $response.OutputStream.Close()
                continue
            }

            # 3. GET /api/candidates
            if ($rawUrl -eq "/api/candidates" -and $request.HttpMethod -eq "GET") {
                $db = Get-Database
                $cands = @($db.candidates)
                $jsonOutput = $cands | ConvertTo-Json -Depth 6
                $bytes = [System.Text.Encoding]::UTF8.GetBytes($jsonOutput)
                $response.StatusCode = 200
                $response.ContentLength64 = $bytes.Length
                $response.OutputStream.Write($bytes, 0, $bytes.Length)
                $response.OutputStream.Close()
                continue
            }

            # 4. POST /api/apply (Candidate Registers/Applies with CV and Eligibility)
            if ($rawUrl -eq "/api/apply" -and $request.HttpMethod -eq "POST") {
                $reader = New-Object System.IO.StreamReader($request.InputStream, $request.ContentEncoding)
                $bodyText = $reader.ReadToEnd()
                $body = $bodyText | ConvertFrom-Json

                $db = Get-Database
                $trackingCode = "TT-2026-" + (Get-Random -Minimum 1000 -Maximum 9999)

                # Determine Experience Tier
                $expNum = 0
                if ($body.experience) { [double]::TryParse($body.experience.ToString(), [ref]$expNum) | Out-Null }
                $tier = "Fresher"
                if ($expNum -ge 6) { $tier = "Senior-Level" }
                elseif ($expNum -ge 2) { $tier = "Mid-Level" }

                $initials = ($body.name.Split(' ') | ForEach-Object { $_[0] }) -join ''
                if ($initials.Length -gt 2) { $initials = $initials.Substring(0, 2) }
                $initials = $initials.ToUpper()

                $candId = if ($body.id) { $body.id } else { ("cand-" + [Guid]::NewGuid().ToString().Substring(0, 8)) }
                $trackingCode = if ($body.tracking_code) { $body.tracking_code } else { ("TT-2026-" + (Get-Random -Minimum 1000 -Maximum 9999)) }

                # Determine Experience Tier
                $tier = if ($body.tier) { $body.tier } else { "Fresher" }

                $initials = if ($body.initials) { 
                    $body.initials 
                } else {
                    $p = ($body.name.Split(' ') | ForEach-Object { $_[0] }) -join ''
                    if ($p.Length -gt 2) { $p = $p.Substring(0, 2) }
                    $p.ToUpper()
                }

                # 4-Milestone Hiring Roadmap
                $candidateRoadmap = @(
                    @{ step = 1; title = "CV Shortlisting"; evaluator = "Neha Gupta (HR Recruiter)"; status = "In Progress"; score = "In Review" },
                    @{ step = 2; title = "Technical Round"; evaluator = "Vikram Malhotra (Tech Round Interviewer)"; status = "Upcoming"; score = "Pending" },
                    @{ step = 3; title = "Final HR Round"; evaluator = "Priya Kulkarni (Final HR Interviewer)"; status = "Upcoming"; score = "Pending" },
                    @{ step = 4; title = "Offer & Selection"; evaluator = "TalentTrack Leadership"; status = "Upcoming"; score = "Pending" }
                )

                $scoresObj = if ($body.scores) {
                    $body.scores
                } else {
                    @{
                        cv_screening = $null
                        tech_assessment = $null
                        tech_interview = $null
                        hr_round = $null
                        overall = 8.5
                    }
                }

                $candPassword = if ($body.password) { $body.password } else { "Candidate@123" }

                $newCand = [PSCustomObject]@{
                    id = $candId
                    name = $body.name
                    initials = $initials
                    role = $body.role
                    tier = $tier
                    stage = "CV Shortlisting"
                    currentStep = 1
                    status = "Under Review"
                    score = $null
                    scores = $scoresObj
                    password = $candPassword
                    email = $body.email
                    phone = if ($body.phone) { $body.phone } else { "+91 90000 00000" }
                    address = if ($body.address) { $body.address } else { "Bengaluru" }
                    resume_name = if ($body.resume_name) { $body.resume_name } else { ($body.name.Replace(' ', '_') + "_Resume.pdf") }
                    referral_name = if ($body.referral_name) { $body.referral_name } else { $null }
                    experience = if ($body.experience) { $body.experience } else { "Applied Candidate" }
                    skills = if ($body.skills) { $body.skills } else { @("Software Engineering") }
                    tracking_code = $trackingCode
                    roadmap = $candidateRoadmap
                    created_at = (Get-Date).ToString("yyyy-MM-ddTHH:mm:ssZ")
                }

                $newApp = [PSCustomObject]@{
                    id = $trackingCode
                    candidate_id = $candId
                    candidate_name = $body.name
                    role = $body.role
                    tier = $tier
                    email = $body.email
                    status = "Under Review (Step 1)"
                    submitted_at = (Get-Date).ToString("yyyy-MM-ddTHH:mm:ssZ")
                }

                $candList = [System.Collections.ArrayList]@($db.candidates)
                $candList.Insert(0, $newCand)
                $db.candidates = $candList

                $appList = [System.Collections.ArrayList]@($db.applications)
                $appList.Insert(0, $newApp)
                $db.applications = $appList

                Save-Database $db

                # Synchronize candidate to MySQL if connected
                if (Test-MySqlIsReachable) {
                    $sqlEscapeName = $body.name.Replace("'", "''")
                    $sqlEscapeRole = $body.role.Replace("'", "''")
                    $sqlEscapeEmail = $body.email.Replace("'", "''")
                    $sqlEscapePass = $candPassword.Replace("'", "''")
                    $sqlEscapePhone = if ($body.phone) { $body.phone.Replace("'", "''") } else { "" }
                    $sqlEscapeAddr = if ($body.address) { $body.address.Replace("'", "''") } else { "" }
                    $sqlEscapeResume = if ($body.resume_name) { $body.resume_name.Replace("'", "''") } else { "" }
                    $sqlEscapeRef = if ($body.referral_name) { $body.referral_name.Replace("'", "''") } else { "" }
                    $expStr = if ($body.experience) { $body.experience.Replace("'", "''") } else { "Applied" }

                    $mysqlInsert = @"
REPLACE INTO candidates (id, tracking_code, name, initials, email, phone, password, address, role, tier, experience, resume_name, referral_name, stage, current_step, status, overall_score)
VALUES ('$candId', '$trackingCode', '$sqlEscapeName', '$initials', '$sqlEscapeEmail', '$sqlEscapePhone', '$sqlEscapePass', '$sqlEscapeAddr', '$sqlEscapeRole', '$tier', '$expStr', '$sqlEscapeResume', '$sqlEscapeRef', 'CV Shortlisting', 1, 'Under Review', NULL);

REPLACE INTO candidate_scores (candidate_id, cv_screening, tech_assessment, tech_interview, hr_round, overall)
VALUES ('$candId', NULL, NULL, NULL, NULL, NULL);

REPLACE INTO candidate_roadmap (candidate_id, step_number, title, evaluator, status, score_label) VALUES
('$candId', 1, 'CV Shortlisting', 'Neha Gupta (HR Recruiter)', 'In Progress', 'Under Review'),
('$candId', 2, 'Technical Round', 'Vikram Malhotra (Tech Round Interviewer)', 'Upcoming', 'Pending'),
('$candId', 3, 'Final HR Round', 'Priya Kulkarni (Final HR Interviewer)', 'Upcoming', 'Pending'),
('$candId', 4, 'Offer & Selection', 'TalentTrack Leadership', 'Upcoming', 'Pending');
"@
                    Invoke-MySqlStatement $mysqlInsert | Out-Null
                }

                $result = @{
                    success = $true
                    tracking_id = $trackingCode
                    tier = $tier
                    candidate = $newCand
                    message = "Application submitted! Candidate recorded in database."
                }

                $jsonOutput = $result | ConvertTo-Json -Depth 6
                $bytes = [System.Text.Encoding]::UTF8.GetBytes($jsonOutput)
                $response.StatusCode = 201
                $response.ContentLength64 = $bytes.Length
                $response.OutputStream.Write($bytes, 0, $bytes.Length)
                $response.OutputStream.Close()
                continue
            }

            # 5. GET /api/track (Track candidate journey by tracking_code or email)
            if ($rawUrl.StartsWith("/api/track") -and $request.HttpMethod -eq "GET") {
                $code = $request.QueryString["code"]
                $email = $request.QueryString["email"]
                $db = Get-Database
                
                $match = $db.candidates | Where-Object { 
                    ($code -and $_.tracking_code -eq $code) -or 
                    ($email -and $_.email -eq $email) -or 
                    ($code -and $_.id -eq $code) 
                } | Select-Object -First 1

                if (-not $match) {
                    # Default to Rahul Sharma if demo or blank
                    $match = $db.candidates | Where-Object { $_.name -eq "Rahul Sharma" } | Select-Object -First 1
                }

                $jsonOutput = $match | ConvertTo-Json -Depth 6
                $bytes = [System.Text.Encoding]::UTF8.GetBytes($jsonOutput)
                $response.StatusCode = 200
                $response.ContentLength64 = $bytes.Length
                $response.OutputStream.Write($bytes, 0, $bytes.Length)
                $response.OutputStream.Close()
                continue
            }

            # 6. POST /api/feedback
            if ($rawUrl -eq "/api/feedback" -and $request.HttpMethod -eq "POST") {
                $reader = New-Object System.IO.StreamReader($request.InputStream, $request.ContentEncoding)
                $bodyText = $reader.ReadToEnd()
                $body = $bodyText | ConvertFrom-Json

                $db = Get-Database
                $newFb = [PSCustomObject]@{
                    id = "fb-" + [Guid]::NewGuid().ToString().Substring(0, 8)
                    candidate_name = $body.candidate_name
                    stage = $body.stage
                    evaluator = if ($body.evaluator) { $body.evaluator } else { "Priya Kulkarni (Talent Lead)" }
                    rating = [double]$body.rating
                    decision = $body.decision
                    date = (Get-Date).ToString("yyyy-MM-dd")
                    quote = $body.quote
                    tags = @($body.tags)
                }

                $fbList = [System.Collections.ArrayList]@($db.feedbacks)
                $fbList.Insert(0, $newFb)
                $db.feedbacks = $fbList

                foreach ($c in $db.candidates) {
                    if ($c.name -eq $body.candidate_name) {
                        $c.score = [double]$body.rating
                    }
                }

                Save-Database $db

                $jsonOutput = $newFb | ConvertTo-Json -Depth 5
                $bytes = [System.Text.Encoding]::UTF8.GetBytes($jsonOutput)
                $response.StatusCode = 201
                $response.ContentLength64 = $bytes.Length
                $response.OutputStream.Write($bytes, 0, $bytes.Length)
                $response.OutputStream.Close()
                continue
            }

            # 7. GET /api/db
            if ($rawUrl -eq "/api/db" -and $request.HttpMethod -eq "GET") {
                $db = Get-Database
                $jsonOutput = $db | ConvertTo-Json -Depth 6
                $bytes = [System.Text.Encoding]::UTF8.GetBytes($jsonOutput)
                $response.StatusCode = 200
                $response.ContentLength64 = $bytes.Length
                $response.OutputStream.Write($bytes, 0, $bytes.Length)
                $response.OutputStream.Close()
                continue
            }

            # 7b. GET /api/database/status
            if ($rawUrl -eq "/api/database/status" -and $request.HttpMethod -eq "GET") {
                $isReachable = Test-MySqlIsReachable
                $hasBin = [bool]$mysqlBin
                $statusPayload = @{
                    database_engine = "MySQL"
                    database_name = $mysqlConfig.database
                    host = $mysqlConfig.host
                    port = $mysqlConfig.port
                    user = $mysqlConfig.user
                    is_mysql_running = $isReachable
                    mysql_cli_found = $hasBin
                    mysql_cli_path = $mysqlBin
                    active_mode = if ($isReachable -and $hasBin) { "Live MySQL Relational Database" } else { "Dual-Storage (MySQL Ready + Auto-Fallback Cache)" }
                    schema_file = "database/schema.sql"
                    config_file = "database/mysql_config.json"
                }
                $jsonOutput = $statusPayload | ConvertTo-Json -Depth 4
                $bytes = [System.Text.Encoding]::UTF8.GetBytes($jsonOutput)
                $response.StatusCode = 200
                $response.ContentLength64 = $bytes.Length
                $response.OutputStream.Write($bytes, 0, $bytes.Length)
                $response.OutputStream.Close()
                continue
            }

            # 404 for other API routes
            $response.StatusCode = 404
            $errBytes = [System.Text.Encoding]::UTF8.GetBytes('{"error": "Endpoint not found"}')
            $response.ContentLength64 = $errBytes.Length
            $response.OutputStream.Write($errBytes, 0, $errBytes.Length)
            $response.OutputStream.Close()
            continue
        }

        # ------------------------------------------------------------------
        # STATIC ASSET SERVING
        # ------------------------------------------------------------------
        if ($rawUrl -eq "/" -or [string]::IsNullOrWhiteSpace($rawUrl)) {
            $rawUrl = "/index.html"
        }

        $cleanRel = ($rawUrl.TrimStart('/')).Replace('/', [System.IO.Path]::DirectorySeparatorChar)
        $localPath = Join-Path $baseDir $cleanRel

        if (Test-Path $localPath -PathType Leaf) {
            $bytes = [System.IO.File]::ReadAllBytes($localPath)
            $ext = [System.IO.Path]::GetExtension($localPath).ToLower()
            switch ($ext) {
                ".html" { $response.ContentType = "text/html; charset=utf-8" }
                ".css"  { $response.ContentType = "text/css; charset=utf-8" }
                ".js"   { $response.ContentType = "application/javascript; charset=utf-8" }
                ".json" { $response.ContentType = "application/json; charset=utf-8" }
                ".png"  { $response.ContentType = "image/png" }
                ".jpg"  { $response.ContentType = "image/jpeg" }
                ".svg"  { $response.ContentType = "image/svg+xml" }
                default { $response.ContentType = "application/octet-stream" }
            }
            $response.ContentLength64 = $bytes.Length
            $response.OutputStream.Write($bytes, 0, $bytes.Length)
        } else {
            $response.StatusCode = 404
            $msg = [System.Text.Encoding]::UTF8.GetBytes("404 Not Found: $rawUrl")
            $response.ContentLength64 = $msg.Length
            $response.OutputStream.Write($msg, 0, $msg.Length)
        }
        $response.Close()
    } catch {
        # continue loop
    }
}
